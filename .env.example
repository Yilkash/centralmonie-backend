PORT=4010
DATABASE_URL=postgres://tenkobo:localdev@localhost:54445/tenkobo
# The web app's origin. Comma-separated if there are several.
CORS_ORIGINS=http://localhost:3010
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# From the Privy dashboard. Put it on one line, with \n for line breaks.
PRIVY_VERIFICATION_KEY=
# Optional. Without it the chat answers with a placeholder and no AI runs.
ANTHROPIC_API_KEY=
# Which Claude model the agent uses.
AGENT_MODEL=claude-haiku-5-5

# simulated: approving pays at once and moves nothing. chain: the user signs and test USDC really moves.
PAYMENTS_MODE=simulated
# Base Sepolia. Mainnet is refused unless ALLOW_REAL_MONEY is set.
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# Required in chain mode: receives USDC for airtime, data and simulated bank payments.
COLLECTION_ADDRESS=
# Optional: signs refunds from the collection address. Needs a little ETH for gas.
COLLECTION_KEY=
# Owner key of the server smart account that runs scheduled payments. Needs a little ETH for gas.
SERVER_OWNER_KEY=
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000

# Agent API. Always open in test mode, where it moves nothing. With real money it also needs this set to true.
AGENT_API_ENABLED=false
# Lets agents pay over x402 with no API key when real money is on. Always open in test mode.
X402_KEYLESS_ENABLED=false
# NEAR Intents' 1Click API. The key lowers the fee and is not required.
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
# How many proxies sit in front of the backend. Set when hosted, so per-address limits see real addresses.
TRUST_PROXY_HOPS=0
# Where people open the web app, for links we hand out. Defaults to the first of CORS_ORIGINS.
PUBLIC_APP_URL=
# Our fee on payments through NEAR Intents, in basis points (100 = 1%). Off at 0. Needs a NEAR account to receive it.
ONECLICK_FEE_BPS=0
ONECLICK_FEE_RECIPIENT=
