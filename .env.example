PORT=4010
DATABASE_URL=postgres://tenkobo:localdev@localhost:54445/tenkobo
# The web app's origin. Comma-separated if there are several.
CORS_ORIGINS=http://localhost:3010
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# From the Privy dashboard. Put it on one line, with \n for line breaks.
PRIVY_VERIFICATION_KEY=
# Optional. Without it the chat answers with a placeholder and no AI runs.
ANTHROPIC_API_KEY=
# Which Claude model the agent uses.
AGENT_MODEL=claude-haiku-5-5
